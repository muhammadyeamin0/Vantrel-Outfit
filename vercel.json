{
  "functions": {
    "api/*.ts": {
      "includeFiles": "{dist/index.html,data/products_store.json,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/product",
      "destination": "/api/products"
    },
    {
      "source": "/api/products/recalculate-prices",
      "destination": "/api/products?action=recalculate-prices"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/products?id=:id"
    },
    {
      "source": "/api/orders/:id/auto-confirm",
      "destination": "/api/orders?id=:id&action=auto-confirm"
    },
    {
      "source": "/api/orders/:id/cancel",
      "destination": "/api/orders?id=:id&action=cancel"
    },
    {
      "source": "/api/orders/:id/approve",
      "destination": "/api/orders?id=:id&action=approve"
    },
    {
      "source": "/api/orders/:id/courier",
      "destination": "/api/orders?id=:id&action=courier"
    },
    {
      "source": "/api/orders/:id/status",
      "destination": "/api/orders?id=:id&action=status"
    },
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/settings/smtp",
      "destination": "/api/store-ops?op=save-smtp-config"
    },
    {
      "source": "/api/send-order-notification",
      "destination": "/api/store-ops?op=send-order-notification"
    },
    {
      "source": "/api/test-email-notification",
      "destination": "/api/store-ops?op=test-email-notification"
    },
    {
      "source": "/api/send-whatsapp-confirmation",
      "destination": "/api/store-ops?op=send-whatsapp-confirmation"
    },
    {
      "source": "/api/finances/:id*",
      "destination": "/api/store-ops?op=finances"
    },
    {
      "source": "/api/moderators/:id*",
      "destination": "/api/store-ops?op=moderators"
    },
    {
      "source": "/api/theme",
      "destination": "/api/store-ops?op=theme"
    },
    {
      "source": "/api/banners-3d",
      "destination": "/api/store-ops?op=banners-3d"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/seo-page?route=product&slug=:slug"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/seo-page?route=category&slug=:slug"
    },
    {
      "source": "/shop",
      "destination": "/api/seo-page?route=shop"
    },
    {
      "source": "/products",
      "destination": "/api/seo-page?route=products"
    },
    {
      "source": "/about",
      "destination": "/api/seo-page?route=about"
    },
    {
      "source": "/contact",
      "destination": "/api/seo-page?route=contact"
    },
    {
      "source": "/faqs",
      "destination": "/api/seo-page?route=faqs"
    },
    {
      "source": "/size-guide",
      "destination": "/api/seo-page?route=size-guide"
    },
    {
      "source": "/shipping-policy",
      "destination": "/api/seo-page?route=shipping-policy"
    },
    {
      "source": "/return-policy",
      "destination": "/api/seo-page?route=return-policy"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/seo-page?route=privacy-policy"
    },
    {
      "source": "/terms",
      "destination": "/api/seo-page?route=terms"
    },
    {
      "source": "/track",
      "destination": "/api/seo-page?route=track"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Storebot-Google|Bingbot|DuckDuckBot|facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|whatsapp|TelegramBot|Discordbot|Slackbot|Twitterbot|LinkedInBot|Pinterest|Viber|Snapchat|redditbot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|anthropic-ai|PerplexityBot|Applebot).*"
        }
      ],
      "destination": "/api/seo-page?route=home"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/image-proxy",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/api/product-image",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.png|favicon-16x16\\.png|favicon-32x32\\.png|favicon-192\\.png|apple-touch-icon\\.png|og-image\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
