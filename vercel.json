{
  "functions": {
    "api/*.ts": {
      "includeFiles": "{dist/index.html,data/products_store.json,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/product",
      "destination": "/api/products"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/seo-page?route=product&slug=:slug"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/seo-page?route=category&slug=:slug"
    },
    {
      "source": "/shop",
      "destination": "/api/seo-page?route=shop"
    },
    {
      "source": "/products",
      "destination": "/api/seo-page?route=products"
    },
    {
      "source": "/about",
      "destination": "/api/seo-page?route=about"
    },
    {
      "source": "/contact",
      "destination": "/api/seo-page?route=contact"
    },
    {
      "source": "/faqs",
      "destination": "/api/seo-page?route=faqs"
    },
    {
      "source": "/size-guide",
      "destination": "/api/seo-page?route=size-guide"
    },
    {
      "source": "/shipping-policy",
      "destination": "/api/seo-page?route=shipping-policy"
    },
    {
      "source": "/return-policy",
      "destination": "/api/seo-page?route=return-policy"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/seo-page?route=privacy-policy"
    },
    {
      "source": "/terms",
      "destination": "/api/seo-page?route=terms"
    },
    {
      "source": "/track",
      "destination": "/api/seo-page?route=track"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Storebot-Google|Bingbot|DuckDuckBot|facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|whatsapp|TelegramBot|Discordbot|Slackbot|Twitterbot|LinkedInBot|Pinterest|Viber|Snapchat|redditbot|Instagram|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|anthropic-ai|PerplexityBot|Applebot).*"
        }
      ],
      "destination": "/api/seo-page?route=home"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/image-proxy",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
